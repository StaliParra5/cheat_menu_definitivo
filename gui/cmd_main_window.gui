# Strategic Comment: Ventana principal modal interactiva para el Cheat Menu Definitivo en CK3.
# Organizada en 5 pestañas temáticas con selector dinámico de objetivo y controles Jomini GUI para todas las funciones.

window = {
	name = "cmd_main_window"
	parentanchor = center
	widgetanchor = center
	size = { 720 620 }
	layer = top
	movable = yes
	
	visible = "[GetVariableSystem.Exists('cmd_window_visible')]"

	# Fondo y borde de ventana nativo de CK3
	using = Window_Background
	using = Window_Decoration

	vbox = {
		using = Window_Margins
		spacing = 10

		# --- ENCABEZADO Y BOTÓN DE CIERRE ---
		header_pattern = {
			layoutpolicy_horizontal = expanding
			
			blockoverride "header_text" {
				text = "cmd_window_title"
			}
			
			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Clear('cmd_window_visible')]"
			}
		}

		# --- SELECTOR DE OBJETIVO (JUGADOR VS OBJETIVO SELECCIONADO) ---
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 5 }
			spacing = 15

			text_single = {
				text = "cmd_target_label"
				align = vcenter
			}

			button_standard = {
				size = { 180 32 }
				text = "cmd_target_self"
				down = "[Not(GetVariableSystem.Exists('cmd_target_mode'))]"
				onclick = "[GetVariableSystem.Clear('cmd_target_mode')]"
				tooltip = "cmd_target_self_tooltip"
			}

			button_standard = {
				size = { 220 32 }
				text = "cmd_target_selected"
				down = "[GetVariableSystem.HasValue('cmd_target_mode', 'selected')]"
				onclick = "[GetVariableSystem.Set('cmd_target_mode', 'selected')]"
				tooltip = "cmd_target_selected_tooltip"
			}
		}

		divider = {
			layoutpolicy_horizontal = expanding
		}

		# --- BARRA DE 5 PESTAÑAS ---
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5

			button_tab = {
				layoutpolicy_horizontal = expanding
				text = "cmd_tab_stats"
				down = "[Or(GetVariableSystem.HasValue('cmd_active_tab', 'tab_stats'), Not(GetVariableSystem.Exists('cmd_active_tab')))]"
				onclick = "[GetVariableSystem.Set('cmd_active_tab', 'tab_stats')]"
			}

			button_tab = {
				layoutpolicy_horizontal = expanding
				text = "cmd_tab_resources"
				down = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_resources')]"
				onclick = "[GetVariableSystem.Set('cmd_active_tab', 'tab_resources')]"
			}

			button_tab = {
				layoutpolicy_horizontal = expanding
				text = "cmd_tab_realm"
				down = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_realm')]"
				onclick = "[GetVariableSystem.Set('cmd_active_tab', 'tab_realm')]"
			}

			button_tab = {
				layoutpolicy_horizontal = expanding
				text = "cmd_tab_traits"
				down = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_traits')]"
				onclick = "[GetVariableSystem.Set('cmd_active_tab', 'tab_traits')]"
			}

			button_tab = {
				layoutpolicy_horizontal = expanding
				text = "cmd_tab_godmode"
				down = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_godmode')]"
				onclick = "[GetVariableSystem.Set('cmd_active_tab', 'tab_godmode')]"
			}
		}

		# --- CONTENIDO DINÁMICO DE PESTAÑAS ---
		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 15
					margin = { 15 15 }

					# PESTAÑA 1: STATS Y SPAWNER DE CORTESANOS
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[Or(GetVariableSystem.HasValue('cmd_active_tab', 'tab_stats'), Not(GetVariableSystem.Exists('cmd_active_tab')))]"
						spacing = 10

						text_label_center = {
							text = "cmd_stats_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_dip_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_diplomacy_5').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_mar_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_martial_5').Execute( GetPlayer.MakeScope )]"
							}
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_ste_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_stewardship_5').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_int_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_intrigue_5').Execute( GetPlayer.MakeScope )]"
							}
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_lea_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_learning_5').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_pro_5"
								onclick = "[GetScriptedEffect('cmd_effect_add_prowess_5').Execute( GetPlayer.MakeScope )]"
							}
						}

						divider = { layoutpolicy_horizontal = expanding }

						text_label_center = {
							text = "cmd_spawner_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_spawn_god_commander"
								onclick = "[GetScriptedEffect('cmd_effect_spawn_god_commander').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_spawn_physician"
								onclick = "[GetScriptedEffect('cmd_effect_spawn_master_physician').Execute( GetPlayer.MakeScope )]"
							}
						}
					}

					# PESTAÑA 2: RECURSOS Y EJÉRCITOS
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_resources')]"
						spacing = 10

						text_label_center = {
							text = "cmd_resources_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_gold_10k"
								onclick = "[GetScriptedEffect('cmd_effect_add_gold').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_prestige_5k"
								onclick = "[GetScriptedEffect('cmd_effect_add_prestige').Execute( GetPlayer.MakeScope )]"
							}
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_piety_5k"
								onclick = "[GetScriptedEffect('cmd_effect_add_piety').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_renown_2k"
								onclick = "[GetScriptedEffect('cmd_effect_add_renown').Execute( GetPlayer.MakeScope )]"
							}
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_add_perk_points"
								onclick = "[GetScriptedEffect('cmd_effect_add_perk_points').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_max_dread"
								onclick = "[GetScriptedEffect('cmd_effect_max_dread').Execute( GetPlayer.MakeScope )]"
							}
						}

						divider = { layoutpolicy_horizontal = expanding }

						text_label_center = {
							text = "cmd_army_header"
						}

						button_primary_big = {
							size = { 280 40 }
							text = "cmd_btn_spawn_special_troops"
							onclick = "[GetScriptedEffect('cmd_effect_spawn_special_troops').Execute( GetPlayer.MakeScope )]"
						}
					}

					# PESTAÑA 3: REINO, CULTURA, RELIGIÓN Y GUERRA
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_realm')]"
						spacing = 10

						text_label_center = {
							text = "cmd_realm_header"
						}

						button_primary_big = {
							size = { 320 42 }
							text = "cmd_btn_toggle_domain_limit"
							onclick = "[GetScriptedEffect('cmd_effect_toggle_domain_limit').Execute( GetPlayer.MakeScope )]"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 220 38 }
								text = "cmd_btn_max_capital"
								onclick = "[GetScriptedEffect('cmd_effect_max_capital_county').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 220 38 }
								text = "cmd_btn_win_wars"
								onclick = "[GetScriptedEffect('cmd_effect_win_current_wars').Execute( GetPlayer.MakeScope )]"
							}
						}

						divider = { layoutpolicy_horizontal = expanding }

						text_label_center = {
							text = "cmd_culture_faith_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 220 38 }
								text = "cmd_btn_convert_capital"
								onclick = "[GetScriptedEffect('cmd_effect_convert_capital_culture_faith').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 220 38 }
								text = "cmd_btn_max_fervor"
								onclick = "[GetScriptedEffect('cmd_effect_max_faith_fervor').Execute( GetPlayer.MakeScope )]"
							}
						}
					}

					# PESTAÑA 4: TRAITS Y GENÉTICA
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_traits')]"
						spacing = 10

						text_label_center = {
							text = "cmd_traits_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_genius"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_genius').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_herculean"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_herculean').Execute( GetPlayer.MakeScope )]"
							}
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_beautiful"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_beautiful').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_augustus"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_augustus').Execute( GetPlayer.MakeScope )]"
							}
						}

						divider = { layoutpolicy_horizontal = expanding }

						text_label_center = {
							text = "cmd_genetics_header"
						}

						hbox = {
							spacing = 10
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_pure_blood"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_pure_blood').Execute( GetPlayer.MakeScope )]"
							}
							button_primary_big = {
								size = { 210 38 }
								text = "cmd_btn_toggle_witch"
								onclick = "[GetScriptedEffect('cmd_effect_toggle_witch').Execute( GetPlayer.MakeScope )]"
							}
						}
					}

					# PESTAÑA 5: MODO DIOS Y OPCIONES
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[GetVariableSystem.HasValue('cmd_active_tab', 'tab_godmode')]"
						spacing = 10

						text_label_center = {
							text = "cmd_godmode_header"
						}

						button_primary_big = {
							size = { 280 44 }
							text = "cmd_btn_toggle_god_mode"
							onclick = "[GetScriptedEffect('cmd_effect_toggle_god_mode').Execute( GetPlayer.MakeScope )]"
						}

						button_primary_big = {
							size = { 280 44 }
							text = "cmd_btn_heal_character"
							onclick = "[GetScriptedEffect('cmd_effect_heal_character').Execute( GetPlayer.MakeScope )]"
						}
					}
				}
			}
		}
	}
}
