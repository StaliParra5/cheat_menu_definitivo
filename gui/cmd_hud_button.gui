# Strategic Comment: Botón de acceso directo en el HUD para abrir/cerrar el Cheat Menu Definitivo.
# Posicionado en la parte superior izquierda (x=160, y=12) visible sobre el mapa sin obstrucciones.

widget = {
	name = "cmd_hud_button_widget"
	parentanchor = top|left
	position = { 160 12 }
	size = { 42 42 }
	layer = top

	button_round = {
		name = "cmd_toggle_button"
		size = { 38 38 }
		parentanchor = center
		onclick = "[GetVariableSystem.Toggle('cmd_window_visible')]"
		tooltip = "cmd_hud_button_tooltip"

		button_icon = {
			texture = "gfx/interface/icons/character_interactions/byzantine_crown_positive.dds"
			size = { 26 26 }
			parentanchor = center
		}
	}
}
