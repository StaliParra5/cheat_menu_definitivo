# Strategic Comment: Botón de acceso directo en el HUD superior derecho para abrir/cerrar el Cheat Menu Definitivo.
# Utiliza el textura válida 'byzantine_crown_positive.dds' nativa de CK3.

widget = {
	name = "cmd_hud_button_widget"
	parentanchor = top|right
	position = { -360 42 }
	size = { 40 40 }
	layer = top

	button_round = {
		name = "cmd_toggle_button"
		size = { 38 38 }
		parentanchor = center
		onclick = "[GetVariableSystem.Toggle('cmd_window_visible')]"
		tooltip = "cmd_hud_button_tooltip"

		button_icon = {
			texture = "gfx/interface/icons/character_interactions/byzantine_crown_positive.dds"
			size = { 26 26 }
			parentanchor = center
		}
	}
}
